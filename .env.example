# Copy this file to .env and adjust as needed. .env is git-ignored.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///data/processed/sales_analytics.db

# --- AI Insights (optional) ---
# Leave LLM_PROVIDER=none to use the built-in rule-based insights engine.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
